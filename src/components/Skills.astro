---
// src/components/Skills.astro

const skillCategories = [
  {
    title: "Frontend",
    skills: ["HTML", "CSS", "JavaScript", "React", "Tailwind"]
  },
  {
    title: "Backend",
    skills: ["Rails", "MySQL", "PostgreSQL"] 
  },
  {
    title: "Learning",
    skills: ["Docker", "Angular", "Python", "TypeScript"]
  },
  {
    title: "Tools",
    skills: ["Git", "GitHub", "VS Code", "npm"]
  }
];
---

<section id="skills-section" class="relative py-24 px-6 lg:px-12">
  <div class="max-w-[1200px] lg:px-8 mx-auto w-full relative z-10">
    
    <div class="mb-16 text-center">
       <h2 class="text-4xl font-bold text-lime-300 mb-4">Tech Stack</h2>
       <p class="text-gray-300">Tools and technologies I work with.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 lg:gap-12">
      {skillCategories.map((category) => (
        <div class="bg-zinc-900/20 p-8 rounded-3xl border border-zinc-400/30 hover:border-lime-500/20 hover:bg-zinc-900/40 transition-all duration-500 group/card">
          <h4 class="text-xl font-semibold text-lime-100 mb-8 flex items-center gap-3">
            <span class="w-2 h-2 rounded-full bg-lime-400"></span>
            {category.title}
          </h4>
          
          <div class="grid grid-cols-3 sm:grid-cols-4 gap-y-8 gap-x-4">
            {category.skills.map((skillName) => (
              <div class="flex flex-col items-center gap-3 group/icon">
                
                <!-- SLOT DE SVG -->
                <div class="h-12 w-12 flex items-center justify-center bg-zinc-800/50 rounded-xl p-2.5 border border-zinc-700/50 group-hover/icon:border-lime-500/50 group-hover/icon:bg-lime-500/10 group-hover/icon:scale-110 transition-all duration-300 shadow-lg">
                  
                  {skillName === "HTML" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-full h-full text-gray-200 group-hover/icon:text-orange-400 transition-colors"><path d="M3 3h18v18H3z"/></svg>
                  )}

                  {skillName === "CSS" && (
                     <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-full h-full text-gray-200 group-hover/icon:text-blue-400 transition-colors"><circle cx="12" cy="12" r="10"/></svg>
                  )}
                  
                   {/* AGREGA AQUÍ TUS OTROS IF PARA LOS ICONOS */}
                   
                   {skillName !== "HTML" && skillName !== "CSS" && (
                     <span class="text-[10px] text-gray-300">SVG</span>
                   )}

                </div>
                <!-- FIN SLOT -->

                <span class="text-xs font-medium text-gray-300 group-hover/icon:text-lime-200 transition-colors">
                  {skillName}
                </span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>