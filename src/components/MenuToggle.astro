---
// src/components/MenuToggle.astro
---

<div id="cont_menu">
  <button id="menu" type="button" aria-label="Toggle Menu">
    <div id="text_menu">
      <div class="inner-text">
        <div>menu</div>
        <div>close</div>
      </div>
    </div>
    <div id="burger">
      <span></span>
      <span></span>
    </div>
  </button>
</div>

<style>
  #cont_menu {
    position: fixed;
    top: 2rem;
    right: 3rem;
    z-index: 1001;
    mix-blend-mode: difference; 
    color: white;
  }

  @media (max-width: 768px) {
    #cont_menu {
      display: none;
    }
  }

  #menu {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
    
    background: none;
    border: none;
    padding: 0;
    
    text-decoration: none;
    color: inherit;
    font-family: 'Geist Mono', monospace;
    text-transform: uppercase;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    font-weight: 600;
  }
  
  #text_menu {
    height: 1.2em;
    overflow: hidden;
    text-align: right;
  }

  .inner-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2em;
    transition: transform 0.6s cubic-bezier(0.19, 1, 0.22, 1);
  }

  body.menu-is-open #text_menu .inner-text {
    transform: translateY(-50%);
  }

  #burger {
    width: 40px;
    height: 12px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  #burger span {
    display: block;
    width: 100%;
    height: 2px;
    background-color: currentColor;
    transition: transform 0.6s cubic-bezier(0.19, 1, 0.22, 1);
  }

  body.menu-is-open #burger span:nth-child(1) {
    transform-origin: center;
    transform: translateY(5px) rotate(45deg);
  }
  body.menu-is-open #burger span:nth-child(2) {
    transform-origin: center;
    transform: translateY(-5px) rotate(-45deg);
  }
</style>

<script>
  const menuButton = document.getElementById('menu');

  if (menuButton) {
    menuButton.addEventListener('click', (e) => {
      e.preventDefault();
      document.body.classList.toggle('menu-is-open');
    });
  }
</script>