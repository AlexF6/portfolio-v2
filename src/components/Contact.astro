---
// src/components/Contact.astro
const EMAIL = "tu-email@ejemplo.com";
---

<section id="contact-section" class="relative py-24 px-6 lg:px-12 scroll-mt-20">
  <div class="max-w-[1200px] px-8 mx-auto w-full relative z-10">
    
    <div class="mb-12 text-center md:text-left">
      <h2 class="text-4xl font-bold text-lime-300 mb-4">Let's Connect</h2>
      <p class="text-gray-300 text-lg max-w-2xl">
        Have a project in mind or just want to say hi? I'm currently open to new opportunities.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-5 gap-8">
      
      <div class="md:col-span-2 flex flex-col gap-6">
        
        <div class="bg-zinc-900/20 border border-zinc-700/50 rounded-3xl p-6 hover:border-lime-500/30 transition-all duration-300 group relative overflow-hidden">
          
          <div class="flex flex-col h-full justify-between gap-4">
            <div>
              <h3 class="text-gray-400 text-sm font-medium uppercase tracking-wider">Email Me</h3>
              <p class="text-xs text-zinc-500 mt-1">Click the button to copy my address</p>
            </div>

            <button 
              id="copy-email-btn"
              class="w-full py-3 px-4 bg-zinc-800 hover:bg-zinc-700 rounded-xl flex items-center justify-center gap-3 text-gray-200 transition-all active:scale-[0.98] group/btn border border-zinc-700 hover:border-lime-500/50"
              aria-label="Copy email to clipboard"
              data-email={EMAIL}
            >
              <span id="icon-mail" class="flex items-center gap-2 transition-all duration-300">
                <svg class="w-5 h-5 text-lime-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <span class="font-medium">Copy Email</span>
              </span>

              <span id="icon-check" class="hidden flex items-center gap-2 text-lime-400 transition-all duration-300 scale-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="font-bold">Copied!</span>
              </span>
            </button>
          </div>
        </div>

        <div class="bg-zinc-900/20 border border-zinc-700/50 rounded-3xl p-6 flex-1">
          <h3 class="text-gray-400 text-sm font-medium mb-4 uppercase tracking-wider">Socials</h3>
          <div class="flex flex-col gap-3">
            
            <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 p-3 rounded-xl hover:bg-zinc-800/50 transition-colors group/link">
              <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-zinc-800 text-white group-hover/link:bg-lime-400 group-hover/link:text-zinc-900 transition-all duration-300">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              </div>
              <span class="text-gray-300 group-hover/link:text-white transition-colors">GitHub</span>
              <svg class="w-4 h-4 text-zinc-600 ml-auto group-hover/link:text-lime-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
            </a>

            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 p-3 rounded-xl hover:bg-zinc-800/50 transition-colors group/link">
              <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-zinc-800 text-white group-hover/link:bg-lime-400 group-hover/link:text-zinc-900 transition-all duration-300">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
              </div>
              <span class="text-gray-300 group-hover/link:text-white transition-colors">LinkedIn</span>
              <svg class="w-4 h-4 text-zinc-600 ml-auto group-hover/link:text-lime-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
            </a>

          </div>
        </div>

      </div>

      <div class="md:col-span-3 bg-zinc-900/20 border border-zinc-700/50 rounded-3xl p-6 md:p-8 hover:border-zinc-600/50 transition-all duration-500">
        
        <form class="flex flex-col gap-6">
          <div class="grid md:grid-cols-2 gap-6">
            <div class="flex flex-col gap-2">
              <label for="name" class="text-sm font-medium text-gray-400 ml-1">Name</label>
              <input 
                type="text" 
                id="name" 
                name="name" 
                placeholder="John Doe"
                class="w-full bg-zinc-950/50 border border-zinc-800 rounded-xl px-4 py-3 text-gray-200 focus:outline-none focus:border-lime-500/50 focus:ring-1 focus:ring-lime-500/50 transition-all placeholder:text-zinc-700"
                required
              />
            </div>
            
            <div class="flex flex-col gap-2">
              <label for="email" class="text-sm font-medium text-gray-400 ml-1">Email</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                placeholder="john@example.com"
                class="w-full bg-zinc-950/50 border border-zinc-800 rounded-xl px-4 py-3 text-gray-200 focus:outline-none focus:border-lime-500/50 focus:ring-1 focus:ring-lime-500/50 transition-all placeholder:text-zinc-700"
                required
              />
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <label for="message" class="text-sm font-medium text-gray-400 ml-1">Message</label>
            <textarea 
              id="message" 
              name="message" 
              rows="4"
              placeholder="Tell me about your project..."
              class="w-full bg-zinc-950/50 border border-zinc-800 rounded-xl px-4 py-3 text-gray-200 focus:outline-none focus:border-lime-500/50 focus:ring-1 focus:ring-lime-500/50 transition-all placeholder:text-zinc-700 resize-none"
              required
            ></textarea>
          </div>

          <button 
            type="submit" 
            class="mt-2 w-full bg-lime-400 text-zinc-900 font-bold py-4 rounded-xl hover:bg-lime-300 hover:scale-[1.01] active:scale-[0.99] transition-all duration-300 flex items-center justify-center gap-2 group"
          >
            <span>Send Message</span>
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
          </button>
        </form>

      </div>

    </div>
  </div>
</section>

<script>
  // UX Logic: Click to Copy Email
  const copyBtn = document.getElementById('copy-email-btn');
  const iconMail = document.getElementById('icon-mail');
  const iconCheck = document.getElementById('icon-check');

  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      const email = copyBtn.getAttribute('data-email');
      
      if (email) {
        navigator.clipboard.writeText(email).then(() => {
          iconMail?.classList.add('hidden');
          iconCheck?.classList.remove('hidden');
          
          setTimeout(() => {
            iconCheck?.classList.remove('scale-0');
          }, 10);

          setTimeout(() => {
            iconCheck?.classList.add('scale-0');
            
            setTimeout(() => {
              iconCheck?.classList.add('hidden');
              iconMail?.classList.remove('hidden');
            }, 300);
          }, 2000);
        });
      }
    });
  }
</script>