---
// src/components/Hero.astro
import Typewriter from "./Typewriter.astro"
---

<section class="relative text-gray-100" id="hero-section">
  <div
    class="mx-auto flex md:min-h-screen flex-col hero gap-10 px-4 py-12
           sm:px-6 lg:px-8 md:flex-row md:items-stretch"
  >
    <div class="flex flex-1 flex-col justify-center space-y-6">
      
      <div class="hero-animate will-change-[opacity,transform] opacity-0 translate-y-12 inline-flex max-w-85 items-center gap-2 rounded-full border border-zinc-800 bg-zinc-900/40 px-3 py-1 text-xs font-medium text-zinc-300 transition-all duration-700 ease-out">
        <span class="h-1.5 w-1.5 rounded-full bg-lime-300 animate-pulse"></span>
        Available for Frontend / Fullstack roles
      </div>

      <h1 class="hero-animate will-change-[opacity,transform] opacity-0 translate-y-12 text-4xl font-bold leading-tight sm:text-5xl md:text-6xl bg-linear-to-r from-lime-300 via-emerald-300 to-cyan-300 bg-clip-text text-transparent transition-all duration-700 ease-out">
        Alexsander Gonzalez
      </h1>

      <div class="hero-animate will-change-[opacity,transform] opacity-0 translate-y-12 flex flex-wrap items-baseline gap-2 text-2xl sm:text-3xl transition-all duration-700 ease-out">
        <span class="text-gray-300">I am a</span>
          <Typewriter
            words={["Software Developer", "UX/UI Enthusiast", "Problem Solver"]}
            typingSpeed={75}
            deletingSpeed={50}
            pauseTime={2000}
          />
      </div>

      <p class="hero-animate will-change-[opacity,transform] opacity-0 translate-y-12 max-w-xl text-sm sm:text-base text-gray-300 transition-all duration-700 ease-out">
        Crafting elegant, performant web experiences that blend creativity with
        cutting-edge technology.
      </p>

      <div class="hero-animate will-change-[opacity,transform] opacity-0 translate-y-12 flex flex-wrap items-center gap-4 transition-all duration-700 ease-out">
        <a
          href="/Alexsander-Gonzalez-CV.pdf"
          download
          class="inline-flex gap-2 items-center rounded-full border border-lime-300 
                  px-5 py-2.5 text-sm font-medium text-lime-100
                 hover:bg-lime-300/20 hover:-translate-y-px
                 focus-visible:outline-none focus-visible:ring-2 
                 focus-visible:ring-lime-300 focus-visible:ring-offset-2 
                 focus-visible:ring-offset-black
                 transition"
        >
        <span>Download Resume</span>
        <span aria-hidden="true" class="text-base">↘</span>
        </a>

        <div class="flex items-center gap-3 text-sm text-gray-400">
          <span class="hidden sm:inline">Find me on</span>
          <nav class="flex gap-2" aria-label="Social links">
            <a
              target="_blank"
              rel="noreferrer"
              href="https://github.com/AlexF6"
              class="inline-flex h-10 w-10 items-center justify-center rounded-full 
                     border border-gray-700 bg-zinc-900/70
                     hover:border-lime-300 hover:text-lime-300
                     focus-visible:outline-none focus-visible:ring-2 
                     focus-visible:ring-lime-300 focus-visible:ring-offset-2 
                     focus-visible:ring-offset-black
                     transition"
              aria-label="GitHub profile"
            >
              <svg
                class="h-5 w-5"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
                shape-rendering="geometricPrecision"
              >
                 <path fill-rule="evenodd" clip-rule="evenodd" d="M12.026 2c-5.509 0-9.974 4.465-9.974 9.974 0 4.406 2.857 8.145 6.821 9.465.499.09.679-.217.679-.481 0-.237-.008-.865-.011-1.696-2.775.602-3.361-1.338-3.361-1.338-.452-1.152-1.107-1.459-1.107-1.459-.905-.619.069-.605.069-.605 1.002.07 1.527 1.028 1.527 1.028.89 1.524 2.336 1.084 2.902.829.091-.645.351-1.085.635-1.334-2.214-.251-4.542-1.107-4.542-4.93 0-1.087.389-1.979 1.024-2.675-.101-.253-.446-1.268.099-2.64 0 0 .837-.269 2.742 1.021a9.582 9.582 0 0 1 2.496-.336 9.554 9.554 0 0 1 2.496.336c1.906-1.291 2.742-1.021 2.742-1.021.545 1.372.203 2.387.099 2.64.64.696 1.024 1.587 1.024 2.675 0 3.833-2.33 4.675-4.552 4.922.355.308.675.916.675 1.846 0 1.334-.012 2.41-.012 2.737 0 .267.178.577.687.479 C19.146 20.115 22 16.379 22 11.974 22 6.465 17.535 2 12.026 2z"></path>
              </svg>
            </a>

            <a
              target="_blank"
              rel="noreferrer"
              href="https://www.linkedin.com/in/alexsander-gonzález-farrayans-149a18267"
              class="inline-flex h-10 w-10 items-center justify-center rounded-full 
                     border border-gray-700 bg-zinc-900/70
                     hover:border-lime-300 hover:text-lime-300
                     focus-visible:outline-none focus-visible:ring-2 
                     focus-visible:ring-lime-300 focus-visible:ring-offset-2 
                     focus-visible:ring-offset-black
                     transition"
              aria-label="LinkedIn profile"
            >
              <svg
                class="h-5 w-5"
                fill="currentColor"
                viewBox="-143 145 512 512"
                aria-hidden="true"
                shape-rendering="geometricPrecision"
              >
                <path d="M329,145h-432c-22.1,0-40,17.9-40,40v432c0,22.1,17.9,40,40,40h432 c22.1,0,40-17.9,40-40V185C369,162.9,351.1,145,329,145z M41.4,508.1H-8.5 V348.4h49.9V508.1z M15.1,328.4h-0.4c-18.1,0-29.8-12.2-29.8-27.7 c0-15.8,12.1-27.7,30.5-27.7c18.4,0,29.7,11.9,30.1,27.7 C45.6,316.1,33.9,328.4,15.1,328.4z M241,508.1h-56.6v-82.6 c0-21.6-8.8-36.4-28.3-36.4c-14.9,0-23.2,10-27,19.6c-1.4,3.4-1.2,8.2-1.2,13.1 v86.3H71.8c0,0,0.7-146.4,0-159.7h56.1v25.1c7.4-11.4,20.5-27.6,50-27.6 c36.5,0,64.1,23.8,64.1,75.1V508.1z"></path>
              </svg>
            </a>
          </nav>
        </div>
      </div>
    </div>

    <!-- Added contain-[layout_paint] to isolate 3D repaints from the text column -->
    <div class="hero-animate opacity-0 translate-y-12 flex flex-1 items-center justify-center mt-8 md:mt-0 transition-all duration-1000 ease-out delay-300 will-change-[opacity,transform]" id="tilt-area">
      <div
        id="model-tilt-container"
        class="mx-auto h-56 w-full max-w-xs 
              sm:h-72 md:h-80 lg:h-96
              perspective-distant
              [contain:layout_paint]" 
      >
        <model-viewer
          id="tilt-model"
          src="/models/bmo.glb"
          alt="3D avatar of Alexsander Gonzalez"
          autoplay
          loading="eager"
          exposure="0.5"
          interaction-prompt="none"
          camera-orbit="90deg 85deg auto"
          disable-zoom
          disable-pan
          class="absolute h-full w-full rounded-3xl"
        ></model-viewer>
      </div>
    </div>
  </div>

  <a 
    href="#experience-section" 
    aria-label="Scroll to skills section"
    class="absolute bottom-7 left-1/2 -translate-x-1/2 animate-bounce will-change-transform"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-13 w-13 text-gray-400 hover:text-lime-300 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </a>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const elements = document.querySelectorAll('.hero-animate');
      
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry, index) => {
          if (entry.isIntersecting) {
            setTimeout(() => {
              entry.target.classList.remove('opacity-0', 'translate-y-12');
              entry.target.classList.add('opacity-100', 'translate-y-0');
            }, index * 150);
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });

      elements.forEach(el => observer.observe(el));
    });

    if (typeof window !== "undefined") {
      const container = document.getElementById("tilt-area");
      const model = document.getElementById("tilt-model") as ModelViewerElement | null;

      if (container && model) {
        const mv = model;
        
        const baseOrbit = { theta: 15, phi: 85 };
        const maxDeviation = { theta: 30, phi: 60 };
        let targetX = 0, targetY = 0;
        let currentX = 0, currentY = 0;
        let animationFrameId: number;

        const handlePointerMove = (event: PointerEvent) => {
          const rect = container.getBoundingClientRect();
          targetX = ((event.clientX - rect.left) / rect.width - 0.5) * 2;
          targetY = ((event.clientY - rect.top) / rect.height - 0.5) * 2;
        };

        const handlePointerLeave = () => {
          targetX = 0;
          targetY = 0;
        };

        const animate = () => {
          const deltaX = targetX - currentX;
          const deltaY = targetY - currentY;

          if (Math.abs(deltaX) < 0.001 && Math.abs(deltaY) < 0.001 && Math.abs(targetX) === 0 && Math.abs(targetY) === 0) {
             currentX = targetX;
             currentY = targetY;
          } else {
             currentX += deltaX * 0.05;
             currentY += deltaY * 0.05;
          }

          const newTheta = baseOrbit.theta - currentX * maxDeviation.theta;
          const newPhi = baseOrbit.phi - currentY * maxDeviation.phi;
          mv.cameraOrbit = `${newTheta}deg ${newPhi}deg auto`;
          
          animationFrameId = requestAnimationFrame(animate);
        };

        const enableDesktopInteraction = () => {
          mv.removeAttribute('camera-controls');
          container.addEventListener("pointermove", handlePointerMove, { passive: true });
          container.addEventListener("pointerleave", handlePointerLeave, { passive: true });
          animate();
        };

        const disableDesktopInteraction = () => {
          cancelAnimationFrame(animationFrameId);
          container.removeEventListener("pointermove", handlePointerMove);
          container.removeEventListener("pointerleave", handlePointerLeave);

          mv.setAttribute('camera-controls', 'true');
          mv.setAttribute('disable-zoom', '');
          mv.setAttribute('disable-pan', '');

          mv.cameraOrbit = `${baseOrbit.theta}deg ${baseOrbit.phi}deg auto`;
        };
        
        const mediaQuery = window.matchMedia("(min-width: 1024px)");

        const handleScreenChange = (query: { matches: boolean }) => {
          if (query.matches) {
            enableDesktopInteraction();
          } else {
            disableDesktopInteraction();
          }
        };

        mv.addEventListener("load", () => {
          handleScreenChange(mediaQuery);
          mediaQuery.addEventListener("change", handleScreenChange);
        });
      }
    }
  </script>
</section>