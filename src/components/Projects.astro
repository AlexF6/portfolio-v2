<script>
  if (typeof window !== "undefined") {
    const cards = document.querySelectorAll('.project-card');
    
    // Check length to avoid observing if empty
    if (cards.length > 0) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry, index) => {
          if (entry.isIntersecting) {
            // Using requestAnimationFrame for smoother animation handling
            // instead of standard setTimeout which is not frame-synced
            const target = entry.target;
            const delay = index * 100; // Slightly faster staggering

            setTimeout(() => {
              requestAnimationFrame(() => {
                target.classList.remove('opacity-0', 'translate-y-12');
                target.classList.add('opacity-100', 'translate-y-0');
              });
            }, delay);

            observer.unobserve(target);
          }
        });
      }, {
        threshold: 0.1,
        rootMargin: "0px 0px -50px 0px"
      });

      cards.forEach(card => observer.observe(card));
    }
  }
</script>