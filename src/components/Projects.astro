---
// src/components/Projects.astro
import { Image } from 'astro:assets';

import proj1 from '../assets/images/projects/proj1.webp';
import proj2 from '../assets/images/projects/proj2.webp';
import proj3 from '../assets/images/projects/proj3.webp';
import proj4 from '../assets/images/projects/proj4.webp';


const projects = [
  {
    title: "Moontube",
    description: "Full-stack video streaming platform inspired by Netflix/YouTube.",
    image: proj1,
    link: "https://moontube-front.vercel.app",
    repo: "https://github.com/AlexF6/moontube-front",
    tags: ["Angular", "TypeScript", "Tailwind", "FastAPI", "PostgreSQL", "Docker"],
    class: "md:col-span-4 md:row-span-2"
  },
  {
    title: "SPOT-AI",
    description: "Curated generative-AI gallery built with Astro, focused on immersive UI",
    image: proj4,
    link: "https://ux-design-peach.vercel.app",
    repo: "https://github.com/AlexF6/ux-design",
    tags: ["Astro", "TypeScript", "CSS", "Three.js"],
    class: "md:col-span-2 md:row-span-2"
  },
  {
    title: "Elysium",
    description: "Alternative clothing e-commerce experience.",
    image: proj3,
    link: "https://owners-quantitative-must-tools.trycloudflare.com",
    repo: "https://github.com/AlexF6/pr-store",
    tags: ["Ruby on Rails", "JavaScript", "Tailwind", "SQLite", "Docker"],
    class: "md:col-span-2 md:row-span-1"
  },
  {
    title: "NANA Beauty",
    description: "Makeup store landing page with a punk/goth aesthetic inspired by NANA, built with Astro and plain CSS ",
    image: proj2,
    link: "https://nana-makeup.vercel.app",
    repo: "https://github.com/AlexF6/nana-makeup",
    tags: ["Astro", "TypeScript", "Tailwind"],
    class: "md:col-span-2 md:row-span-1"
  }
];
---

<!-- Added [content-visibility:auto] and [contain:layout_paint] for massive performance gain when off-screen -->
<section id="projects-section" class="relative py-24 px-6 lg:px-12 [content-visibility:auto] contain-[layout_paint]">
  <div class="max-w-[1200px] lg:px-8 mx-auto w-full relative z-10">
    
    <div class="mb-16 text-center">
       <h2 class="text-4xl font-bold text-lime-300 mb-4">Featured Projects</h2>
       <p class="text-gray-300">Some of the things I've built recently.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 auto-rows-[300px] gap-6">
      
      {projects.map((project) => (
        <div 
          class={`
            project-card opacity-0 translate-y-12
            group/card relative overflow-hidden rounded-3xl 
            bg-zinc-900/20 border border-zinc-700/50 
            hover:border-lime-500/50 transition-all duration-700 ease-out
            will-change-[opacity,transform]
            ${project.class}
          `}
        >
          <!-- 1. INVISIBLE MAIN LINK (Background Click) -->
          <a href={project.link} target="_blank" class="absolute inset-0 z-20 cursor-pointer" aria-label={`View ${project.title}`}></a>

          <!-- 2. BACKGROUND IMAGE -->
          <div class="absolute inset-0 w-full h-full overflow-hidden pointer-events-none">
            <div class="absolute inset-0 bg-linear-to-br from-zinc-800 to-black z-0"></div>
              <!-- Added decoding="async" and fetchpriority="low" -->
              <Image
                src={project.image}
                alt={project.title}
                class="w-full h-full object-cover object-center opacity-60 group-hover/card:scale-110 group-hover/card:opacity-80 transition-all duration-700 ease-out relative z-10 will-change-transform"
                loading="lazy"
                decoding="async"
                fetchpriority="low"
              />
            <div class="absolute inset-0 bg-linear-to-t from-zinc-950 via-zinc-950/50 to-transparent z-20"></div>
          </div>

          <!-- 3. CONTENT BOX -->
          <div class="absolute bottom-0 left-0 w-full p-6 z-30 flex flex-col justify-end h-full pointer-events-none">
            
            <!-- Added will-change-transform for the hover lift effect -->
            <div class="bg-zinc-950/80 backdrop-blur-md border border-zinc-700/50 rounded-2xl p-5 translate-y-4 group-hover/card:translate-y-0 transition-transform duration-500 pointer-events-auto will-change-transform">
              
              <div class="flex items-start justify-between gap-4 mb-2">
                <h3 class="text-xl font-bold text-white group-hover/card:text-lime-300 transition-colors">
                  {project.title}
                </h3>

                <div class="flex gap-2 shrink-0">
                  {project.repo && (
                    <a 
                      href={project.repo} 
                      target="_blank" 
                      aria-label={`View source code for ${project.title}`}
                      class="p-2 bg-zinc-800 hover:bg-zinc-700 hover:text-white text-zinc-400 rounded-lg transition-colors border border-zinc-700 hover:border-zinc-500 relative z-40"
                    >
                      <svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" shape-rendering="geometricPrecision"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                    </a>
                  )}
                  <a 
                    href={project.link} 
                    target="_blank" 
                    aria-label={`Visit live demo of ${project.title}`}
                    class="p-2 bg-lime-400/10 hover:bg-lime-400 hover:text-black text-lime-400 rounded-lg transition-colors border border-lime-400/20 hover:border-lime-400 relative z-40"
                  >
                    <svg aria-hidden="true" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" shape-rendering="geometricPrecision"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                  </a>
                </div>
              </div>
              
              <p class="text-sm text-gray-300 line-clamp-2 mb-4">
                {project.description}
              </p>

              <div class="flex flex-wrap gap-2">
                {project.tags.map((tag) => (
                  <div class="p-2 rounded-lg bg-zinc-800/80 border border-zinc-700 group-hover/card:border-lime-500/30 transition-colors" title={tag}>
                    <div class="w-5 h-5">
                      {tag === "React" && (
