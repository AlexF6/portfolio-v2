---
// src/components/Experience.astro

const experiences = [
  {
    year: "2025",
    title: "Front-End Developer",
    company: "Abatech",
    description: "Developing React applications with TypeScript and Material UI, implementing robust form handling with React Hook Form and focusing on usability and maintainable front-end architecture."
  },
];

const education = [
  {
    year: "2022 - Present",
    title: "Technology in Software Development",
    institution: "Instituto Tecnológico Metropolitano de Medellín"
  }
];
---

<section id="experience-section" class="relative pb-12 pt-12 px-6 lg:px-12 overflow-hidden">
  <!-- Background Glow -->
  <div class="absolute top-1/2 left-0 w-64 h-64 rounded-full blur-[100px] -translate-y-1/2 -translate-x-1/2 pointer-events-none"></div>

  <div class="max-w-[1200px] lg:px-8 mx-auto w-full relative z-10">
    <div class="grid lg:grid-cols-2 gap-16">

      <!-- EXPERIENCE COLUMN -->
      <div>
        <h3 class="flex items-center justify-center gap-3 text-3xl font-bold text-lime-300 mb-10">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          Experience
        </h3>

        <div class="space-y-12 md:space-y-10 md:border-l border-zinc-800 md:ml-3 md:pl-10 relative flex flex-col items-center md:block">
          {experiences.map((exp) => (
            <div class="timeline-item opacity-0 translate-y-12 relative group transition-all duration-700 ease-out flex flex-col items-center md:items-start text-center md:text-left w-full">
              
              <div class="hidden md:block absolute -left-[45px] top-1.5 h-3 w-3 rounded-full bg-zinc-800 border border-zinc-600 group-hover:bg-lime-400 group-hover:border-lime-400 transition-colors duration-300"></div>
              
              <div class="flex flex-col mb-2 w-full">
                <span class="text-xs font-mono text-lime-300/80 mb-1">{exp.year}</span>
                <h4 class="text-xl font-semibold text-white group-hover:text-lime-100 transition-colors">{exp.title}</h4>
              </div>
              <div class="text-gray-200 font-medium mb-3">{exp.company}</div>
              <p class="text-gray-300 text-sm leading-relaxed max-w-md mx-auto md:mx-0">{exp.description}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- EDUCATION COLUMN -->
      <div>
        <h3 class="flex items-center justify-center gap-3 text-3xl font-bold text-lime-300 mb-10">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m16 6 4 14"/><path d="M12 6v14"/><path d="M8 8v12"/><path d="M4 4v16"/></svg>
          Education
        </h3>

        <!-- Same structural changes as above -->
        <div class="space-y-12 md:space-y-10 md:border-l border-zinc-800 md:ml-3 md:pl-10 relative flex flex-col items-center md:block">
          {education.map((edu) => (
            <div class="timeline-item opacity-0 translate-y-12 relative group transition-all duration-700 ease-out flex flex-col items-center md:items-start text-center md:text-left w-full">
              
              <!-- Dot hidden on mobile -->
              <div class="hidden md:block absolute -left-[45px] top-1.5 h-3 w-3 rounded-full bg-zinc-800 border border-zinc-600 group-hover:bg-lime-400 group-hover:border-lime-400 transition-colors duration-300"></div>
              
              <div class="flex flex-col mb-2 w-full">
                 <span class="text-xs font-mono text-lime-300/80 mb-1">{edu.year}</span>
                 <h4 class="text-xl font-semibold text-white group-hover:text-lime-100 transition-colors">{edu.title}</h4>
              </div>
              <p class="text-gray-300 text-sm">{edu.institution}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const items = document.querySelectorAll('.timeline-item');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry, index) => {
        if (entry.isIntersecting) {
          setTimeout(() => {
            entry.target.classList.remove('opacity-0', 'translate-y-12');
            entry.target.classList.add('opacity-100', 'translate-y-0');
          }, index * 150);
          
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.2,
      rootMargin: "0px 0px -50px 0px"
    });

    items.forEach(item => observer.observe(item));
  });
</script>