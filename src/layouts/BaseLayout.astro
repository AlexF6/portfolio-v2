---
// src/layouts/BaseLayout.astro
import CustomCursor from "../components/CustomCursor.astro";
import MenuToggle from "../components/MenuToggle.astro";
import NavigationMenu from "../components/NavigationMenu.astro";
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
}

const { title, description = "Welcome to my website" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="bg-black text-gray-300">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <title>{title}</title>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&display=swap" rel="stylesheet">
    <script
      type="module"
      src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"
    ></script>

    <!-- Slot for additional head content -->
    <slot name="head" />
  </head>

  <body class="min-h-screen bg-black text-gray-300">
    <MenuToggle/>
    <NavigationMenu/>
    <!-- Header -->
    <header>
    </header>

    <!-- Main Content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer>
    </footer>
      <CustomCursor />

    <!-- SCRIPT CON TIPADO CORREGIDO -->
    <script>
      // Especificamos que buscamos elementos <a> para que 'trigger' sea del tipo correcto.
      document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(trigger => {
        // CAMBIO: Usamos una arrow function para evitar el problema con 'this'.
        trigger.addEventListener('click', (e: MouseEvent) => {
          // 1. Previene el comportamiento por defecto del enlace
          e.preventDefault();

          // CAMBIO: Usamos 'trigger' en lugar de 'this'.
          const targetId = trigger.getAttribute('href');
          if (!targetId) return; // Salimos si el href está vacío
          
          const elementoDestino = document.querySelector(targetId);

          if (elementoDestino) {
            const posicionInicial = window.scrollY;
            const offset = 0;
            const posicionFinal = elementoDestino.getBoundingClientRect().top + posicionInicial - offset;
            const distancia = posicionFinal - posicionInicial;
            
            const duracion = 1500;
            let startTime: number | null = null; // TIPO AÑADIDO

            // TIPO AÑADIDO para todos los parámetros
            const easeInOutQuad = (t: number, b: number, c: number, d: number) => {
              t /= d / 2;
              if (t < 1) return c / 2 * t * t + b;
              t--;
              return -c / 2 * (t * (t - 2) - 1) + b;
            };

            // TIPO AÑADIDO para 'currentTime'
            const animacion = (currentTime: number) => {
              if (startTime === null) startTime = currentTime;
              const tiempoTranscurrido = currentTime - startTime;
              
              const scrollActual = easeInOutQuad(tiempoTranscurrido, posicionInicial, distancia, duracion);
              
              window.scrollTo(0, scrollActual);

              if (tiempoTranscurrido < duracion) {
                requestAnimationFrame(animacion);
              }
            };

            requestAnimationFrame(animacion);
          }
        });
      });
    </script>
    
    <slot name="scripts" />
  </body>
</html>